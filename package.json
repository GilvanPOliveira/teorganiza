{
  "name": "teorganiza",
  "version": "0.0.1",
  "private": true,
  "description": "Organizador financeiro que roda no navegador: extratos entram, o caminho do dinheiro sai.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "pdfjs-dist": "^4.8.69"
  }
}
